global:
  scrape_interval: 15s
  scrape_timeout: 10s
  evaluation_interval: 15s


scrape_configs:

  # ----------------------------------------------------------
  # Prometheus itself
  # ----------------------------------------------------------
  - job_name: "prometheus"

    static_configs:
      - targets:
          - "prometheus:9090"


  # ----------------------------------------------------------
  # Management EC2 host metrics
  # ----------------------------------------------------------
  - job_name: "node-management"

    static_configs:
      - targets:
          - "node-exporter-management:9100"

        labels:
          environment: "lab"
          role: "management"


  # ----------------------------------------------------------
  # Private application EC2 host metrics
  # ----------------------------------------------------------
  - job_name: "node-app"

    static_configs:
      - targets:
          - "{{ hostvars[groups['app'][0]].ansible_host }}:9100"

        labels:
          environment: "lab"
          role: "application"


  # ----------------------------------------------------------
  # Jenkins metrics
  # ----------------------------------------------------------
  - job_name: "jenkins"
    metrics_path: "/jenkins/prometheus/"

    basic_auth:
     username: "{{ vault_jenkins_monitor_username }}"
     password: "{{ vault_jenkins_monitor_token }}"

    static_configs:
     - targets:
        - "jenkins:8080"


  # ----------------------------------------------------------
  # SonarQube project quality metrics
  # ----------------------------------------------------------
  - job_name: "sonar-quality"

    metrics_path: "/metrics"

    static_configs:
      - targets:
          - "sonar-exporter:9101"
