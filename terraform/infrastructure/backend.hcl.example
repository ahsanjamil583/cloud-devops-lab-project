bucket         = "cloud-devops-lab-project-tfstate-<ACCOUNT-ID>-ap-south-1"
key            = "infrastructure/terraform.tfstate"
region         = "ap-south-1"
encrypt        = true

# Internship requirement
dynamodb_table = "cloud-devops-lab-project-tf-locks"

# Current Terraform locking mechanism
use_lockfile   = true
